    alteracao_proposta --> recusada : quem recebe a proposta recusa
    pendente --> cancelada : desafiante cancela
    alteracao_proposta --> cancelada : qualquer equipa cancela
    aceite --> [*] : cria Jogo (agendado)
    recusada --> [*]
    cancelada --> [*]
