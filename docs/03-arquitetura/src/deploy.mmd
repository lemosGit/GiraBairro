flowchart LR
    U["👥 Utilizadores<br/>navegador / app Android"]
    CF["Cloudflare<br/>DNS + CDN + WAF"]
    subgraph VPS["VPS — Docker Compose"]
        direction TB
        CAD["Caddy<br/>HTTPS automático"]
        WEB["web<br/>Next.js"]
        API["api<br/>FastAPI (uvicorn)"]
        WRK["worker<br/>APScheduler"]
