    REG["GitHub Container Registry"]
    U -- HTTPS --> CF -- HTTPS --> CAD
    CAD -- "girabairro.tld" --> WEB
    CAD -- "api.girabairro.tld" --> API
    U -. "app → api.girabairro.tld" .-> CF
